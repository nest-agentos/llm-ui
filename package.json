{
  "name": "@itookit/llm-ui",
  "version": "0.4.0",
  "description": "Host-driven native DOM chat and Flow components",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css",
    "./flow": "./src/flow.ts",
    "./forms": "./src/parameter-form.ts",
    "./forms.css": "./src/forms.css",
    "./flow.css": "./src/flow.css",
    "./settings": "./src/settings.ts",
    "./settings.css": "./src/settings.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/llm-ui.umd.cjs",
    "module": "./dist/llm-ui.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/llm-ui.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/llm-ui.umd.cjs"
        }
      },
      "./style.css": "./dist/style.css",
      "./flow": {
        "types": "./dist/flow.d.ts",
        "import": "./dist/flow.js"
      },
      "./flow.css": "./dist/flow.css",
      "./forms": {
        "import": {
          "types": "./dist/parameter-form.d.ts",
          "default": "./dist/forms.js"
        },
        "require": {
          "types": "./dist/parameter-form.d.cts",
          "default": "./dist/forms.cjs"
        }
      },
      "./forms.css": "./dist/forms.css",
      "./settings": {
        "import": {
          "types": "./dist/settings.d.ts",
          "default": "./dist/settings.js"
        },
        "require": {
          "types": "./dist/settings.d.cts",
          "default": "./dist/settings.cjs"
        }
      },
      "./settings.css": "./dist/settings.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.flow.config.ts && vite build --config vite.forms.config.ts && vite build --config vite.settings.config.ts && tsup --config tsup.config.ts && node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@itookit/mdxeditor": "^0.6.0",
    "@itookit/ui-common": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "jsdom": "^27.4.0",
    "@types/node": "^20.19.25",
    "tsup": "^8.5.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nest-agentos/llm-ui.git"
  },
  "homepage": "https://github.com/nest-agentos/llm-ui#readme",
  "bugs": {
    "url": "https://github.com/nest-agentos/llm-ui/issues"
  }
}
